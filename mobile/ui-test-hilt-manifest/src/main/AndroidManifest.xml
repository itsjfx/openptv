<?xml version="1.0" encoding="utf-8"?>
<!--
  Declares HiltComponentActivity so feature androidTests can launch it via
  createAndroidComposeRule<HiltComponentActivity>(). Marked `android:exported="false"`
  because it is purely an in-process test host — no one outside this APK should ever start it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="ac.jfx.openptv.uitesthiltmanifest.HiltComponentActivity"
            android:exported="false" />
    </application>

</manifest>
