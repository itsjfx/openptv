<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">OpenPTV</string>
    <string name="home_title">OpenPTV</string>
    <string name="home_subtitle">Public Transport Victoria, Material You.</string>
    <string name="home_open_search">Search stops</string>

    <!-- Bottom-navigation tab labels. Plain glyphs stand in for Material Icons so :app stays
         off the icons artifact. Settings is no longer a tab — it lives behind a top-left gear
         on each main screen (issue #111) and is pushed as a destination so system back returns
         to the launching tab. -->
    <string name="bottom_nav_favourites">Favourites</string>
    <string name="bottom_nav_nearby">Nearby</string>
    <string name="bottom_nav_search">Search</string>

    <!-- Stop search strings live in :feature:search/.../strings.xml.
         Settings (theme mode + dynamic colour) strings live in :feature:settings. -->

    <!-- First-run setup. The three radio rows + their bodies + the custom URL / direct-PTV
         field labels are shared with the Settings server-picker dialog and live in
         `:feature:settings/res/values/strings.xml` under the `feature_settings_server_*` prefix.
         Only the title, intro, and Continue CTA are :app-local. -->
    <string name="setup_title">Choose your server</string>
    <string name="setup_intro">OpenPTV needs to know which backend to talk to. Pick a server below.</string>
    <string name="setup_continue">Continue</string>

    <!-- Pinned followed-trip bar (issue #200). The Follow/Unfollow action on the run pattern
         screen lives in :feature:run-pattern; only the app-wide bar is :app-local. -->
    <string name="followed_trip_return">Return to your trip</string>
    <!-- Trip name. Slots: route label ("Lilydale", "96"), destination ("Flinders Street"). -->
    <string name="followed_trip_format">%1$s to %2$s</string>
    <string name="followed_trip_open_content_description">Return to your followed trip</string>
    <string name="followed_trip_unfollow_content_description">Stop following this trip</string>
    <!-- Live progress line. Slot: the next upcoming stop's name ("Richmond Station"). -->
    <string name="followed_trip_next_stop">Next stop: %1$s</string>
</resources>
