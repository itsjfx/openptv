<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Favourites screen. Resource prefix matches the AGP `resourcePrefix` set by the
         `openptv.android.library` convention plugin: every string here starts with
         `feature_favourites_`. -->
    <string name="feature_favourites_title">Favourites</string>
    <string name="feature_favourites_departing_now">Departing now</string>

    <!-- Empty state -->
    <string name="feature_favourites_empty">Star a destination at a stop to favourite it.</string>
    <string name="feature_favourites_empty_cta">Search for a stop</string>

    <!-- Edit mode (issue #78) -->
    <string name="feature_favourites_edit_enter">Edit favourites</string>
    <string name="feature_favourites_edit_done">Done editing</string>

    <!-- Row -->
    <string name="feature_favourites_row_drag_handle">Drag to reorder</string>
    <string name="feature_favourites_row_delete">Delete favourite</string>
    <string name="feature_favourites_next_loading">Loading…</string>
    <string name="feature_favourites_next_none">No upcoming departures</string>
    <string name="feature_favourites_next_error">No data</string>

    <!-- Undo snackbar -->
    <string name="feature_favourites_removed">Removed</string>
    <string name="feature_favourites_undo">Undo</string>

    <!-- "to {destinationName}" secondary line on the row. -->
    <string name="feature_favourites_to_destination">to %1$s</string>

    <!-- Journey favourites section (issue #209) -->
    <string name="feature_favourites_journeys_header">Journeys</string>
    <string name="feature_favourites_journey_endpoints">%1$s → %2$s</string>
    <string name="feature_favourites_journey_departs">Departs %1$s</string>
    <string name="feature_favourites_journey_arrives">Arrives %1$s</string>
    <string name="feature_favourites_journey_duration">%1$d min journey</string>
    <string name="feature_favourites_journey_platform">Platform %1$s</string>
    <string name="feature_favourites_journey_none">No direct services right now</string>

    <!-- Row content description: stop, suburb, destination, next departure phrase -->
    <string name="feature_favourites_row_content_description">%1$s, %2$s. To %3$s. Next departure %4$s.</string>

    <!-- Bottom-nav glyph stand-ins (no Material Icons dep) -->
    <string name="feature_favourites_tab_label">Favourites</string>

    <!-- Top-left gear (issue #111) — opens settings, replaces the old Settings bottom-nav tab. -->
    <string name="feature_favourites_open_settings">Open settings</string>
</resources>
