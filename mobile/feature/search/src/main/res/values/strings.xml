    <string name="feature_search_field_label">Stop name or suburb</string>
    <string name="feature_search_idle_hint">Start typing to search.</string>
    <string name="feature_search_empty">No stops match that search.</string>
    <string name="feature_search_row_open">Open</string>
    <string name="feature_search_row_content_description">%1$s, %2$s, %3$s stop</string>
    <string name="feature_search_unknown_suburb">unknown suburb</string>

    <!-- Transport modes -->
    <string name="feature_search_route_type_train">Train</string>
    <string name="feature_search_route_type_tram">Tram</string>
    <string name="feature_search_route_type_bus">Bus</string>
    <string name="feature_search_route_type_vline">V/Line</string>
    <string name="feature_search_route_type_night_bus">Night Bus</string>
    <string name="feature_search_route_type_unknown">Stop</string>

    <!-- Top-left gear (issue #111) — opens settings, replaces the old Settings bottom-nav tab. -->
    <string name="feature_search_open_settings">Open settings</string>
