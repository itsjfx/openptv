<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Settings screen. Resource prefix matches the AGP `resourcePrefix` set by the
         `openptv.android.library` convention plugin: every string in :feature:settings starts
         with `feature_settings_`. -->
    <string name="feature_settings_title">Settings</string>

    <!-- Appearance section -->
    <string name="feature_settings_appearance_section">Appearance</string>

    <!-- Theme mode -->
    <string name="feature_settings_theme_mode_label">Theme</string>
    <string name="feature_settings_theme_mode_system">System default</string>
    <string name="feature_settings_theme_mode_light">Light</string>
    <string name="feature_settings_theme_mode_dark">Dark</string>

    <!-- Dynamic colour -->
    <string name="feature_settings_dynamic_colour_label">Dynamic colour</string>
    <string name="feature_settings_dynamic_colour_supported_subtitle">Use colours derived from your wallpaper.</string>
    <string name="feature_settings_dynamic_colour_unsupported_subtitle">Available on Android 12+</string>

    <!-- Time format section. Controls how every absolute time the app renders
         (departure rows, "as of" footer, favourite row clock-times) is shown. Relative
         strings like "in 4 min" are unaffected. -->
    <string name="feature_settings_time_format_section">Time format</string>
    <string name="feature_settings_time_format_system">Follow system</string>
    <string name="feature_settings_time_format_twelve">12-hour (3:30 PM)</string>
    <string name="feature_settings_time_format_twenty_four">24-hour (15:30)</string>

    <!-- Server section. Mirrors the wording used by the first-run setup screen so users see the
         same vocabulary in both places. -->
    <string name="feature_settings_server_section">Server</string>
    <string name="feature_settings_server_label">Backend server</string>
    <string name="feature_settings_server_dialog_title">Choose your server</string>
    <string name="feature_settings_server_default_title">Use the default server</string>
    <string name="feature_settings_server_default_body">Bundled URL, suitable for emulator development and the hosted release.</string>
    <string name="feature_settings_server_custom_title">Use a custom server</string>
    <string name="feature_settings_server_custom_body">Run your own proxy and point the app at it. The address is stored on this device only.</string>
    <string name="feature_settings_server_custom_field_label">Backend URL</string>
    <string name="feature_settings_server_custom_field_placeholder">http://192.168.1.10:8080/api/v3/</string>
    <string name="feature_settings_server_custom_field_helper">Include scheme, host, port, and the /api/v3/ path. A trailing slash will be added automatically.</string>
    <string name="feature_settings_server_dialog_save">Save</string>
    <string name="feature_settings_server_dialog_cancel">Cancel</string>

    <!-- Direct PTV mode (issue #102). Lets users supply their own dev_id + key and bypass
         the proxy. The toggle, devid label, and api_key label all live in the Server section
         so users find them next to the proxy URL row. -->
    <string name="feature_settings_direct_mode_label">Use my own PTV API key</string>
    <string name="feature_settings_direct_mode_subtitle">Sign requests on-device and skip the backend.</string>
    <string name="feature_settings_direct_mode_devid_label">PTV dev_id</string>
    <string name="feature_settings_direct_mode_apikey_label">PTV API key</string>
    <string name="feature_settings_direct_mode_helper">Stored on this device only. Both fields are required for direct mode to take effect; if either is blank the app falls back to the proxy.</string>
</resources>
