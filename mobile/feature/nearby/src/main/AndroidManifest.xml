<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Coarse-only — PTV stops have walking-distance granularity, so fine location adds nothing
        for the nearby map. Matches the Compose-side rationale in `:core:designsystem`'s
        `LocationPermissionRationale` and the permission check in `LocationManagerLocationProvider`.

        Background location is intentionally NOT declared: the screen only needs a fix while the
        user is looking at it. See `docs/mobile/phase-05-nearby-map.md` for the rationale.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

</manifest>
