<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Both COARSE and FINE are declared so Android 12+ renders the system "Precise / Approximate"
        toggle on the runtime prompt (issue #91). The user picks; either grant is enough for the
        nearby map to function. See the rationale on `LocationManagerLocationProvider` and the
        runtime request in `NearbyScreen`.

        Background location is intentionally NOT declared: the screen only needs a fix while the
        user is looking at it. See `docs/mobile/phase-05-nearby-map.md` for the rationale.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

</manifest>
