<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Run-pattern screen (issue #132). Resource prefix matches the AGP `resourcePrefix` set by
         the `openptv.android.library` convention plugin: every string in :feature:run-pattern
         starts with `feature_run_pattern_`. -->
    <string name="feature_run_pattern_title">Service</string>
    <!-- Top-bar title once the pattern resolves. Slots: route label ("Lilydale", "96"),
         destination ("Flinders Street"). -->
    <string name="feature_run_pattern_title_format">%1$s to %2$s</string>
    <string name="feature_run_pattern_loading">Loading stops…</string>
    <string name="feature_run_pattern_empty">No stops for this service.</string>
    <string name="feature_run_pattern_empty_subtitle">The run may have already finished for the day.</string>
    <string name="feature_run_pattern_error">Couldn\'t load the service\'s stops.</string>
    <string name="feature_run_pattern_retry">Retry</string>
    <string name="feature_run_pattern_as_of">As of %1$s</string>
    <string name="feature_run_pattern_scheduled">scheduled %1$s</string>
    <string name="feature_run_pattern_platform">platform %1$s</string>
    <!-- Chip on the stop the user tapped through from ("you are here"). -->
    <string name="feature_run_pattern_this_stop">This stop</string>
    <plurals name="feature_run_pattern_delay_late">
        <item quantity="one">%d min late</item>
        <item quantity="other">%d mins late</item>
    </plurals>
    <plurals name="feature_run_pattern_delay_early">
        <item quantity="one">%d min early</item>
        <item quantity="other">%d mins early</item>
    </plurals>
    <!-- Stop row content description. Slots: stop name, relative time phrase ("in 3 minutes",
         "having already departed"). -->
    <string name="feature_run_pattern_row_content_description">%1$s, departing %2$s</string>
    <!-- Collapsible route-line map (issue #187). -->
    <string name="feature_run_pattern_map_show">Show map</string>
    <string name="feature_run_pattern_map_hide">Hide map</string>
    <string name="feature_run_pattern_map_content_description">Map of the route with the service\'s stops drawn along it</string>
    <!-- Follow this trip (issue #200). Top-bar action; the pinned "Return to your trip" bar
         itself lives in :app. -->
    <string name="feature_run_pattern_follow">Follow</string>
    <string name="feature_run_pattern_unfollow">Unfollow</string>
    <!-- Replace-confirmation when a different trip is already followed. Slot: the currently
         followed trip's name ("Lilydale to Flinders Street"). -->
    <string name="feature_run_pattern_follow_replace_title">Follow this trip instead?</string>
    <string name="feature_run_pattern_follow_replace_body">You\'re following %1$s. Only one trip can be followed at a time — following this one replaces it.</string>
    <string name="feature_run_pattern_follow_replace_confirm">Replace</string>
    <string name="feature_run_pattern_follow_replace_cancel">Cancel</string>
    <!-- Alight alerts (issue #201). The bell on each upcoming stop row arms/disarms the
         "I'm getting off here" alert; arming also follows the trip. -->
    <string name="feature_run_pattern_alight_here">Getting off here</string>
    <!-- Slot: stop name. -->
    <string name="feature_run_pattern_alight_arm_content_description">Alert me before %1$s</string>
    <!-- Slot: stop name. -->
    <string name="feature_run_pattern_alight_disarm_content_description">Cancel the getting-off alert for %1$s</string>
    <string name="feature_run_pattern_alight_notifications_denied">Notifications are blocked — getting-off alerts can\'t be shown.</string>
    <string name="feature_run_pattern_alight_schedule_only">No live tracking for this service — alerts will follow the timetable only.</string>
</resources>
